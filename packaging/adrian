#!/usr/bin/env bash
# adrian: manage the A.D.R.I.A.N. Discord voice service.
#
#   adrian status                 service state, health, admin UI address
#   adrian logs [-f]              recent log (secrets are redacted)
#   adrian start|stop|restart
#   adrian url                    admin UI address
#   adrian setup-code [--new]     one-time code for creating the admin account
#   adrian reset-admin            forgot the password: remove the admin account
#   adrian secret set NAME        set a key (prompted, hidden); also: delete NAME, list
#   adrian check                  what's missing before the bot can start
#   adrian voice [NAME [SPEED]]   show or change the voice (restarts the bot)
#   adrian config KEY [VALUE]     show or change a setting, e.g. brain.extraBody.reasoning_effort medium
#   adrian satellite add NAME OWNER_ID   pair a PC (prints its token once); also: list, remove ID
#   adrian doctor                 full diagnostics
#   adrian backup [FILE]          config, keys and state (not models) to a tar.gz
#   adrian restore FILE
#   adrian update                 install the newest release from GitHub (checksum verified);
#                                 rolls back if it does worse than the old one. Also: update
#                                 BUNDLE.tar.gz [--require-checksum], update --check (is there
#                                 a newer one?). By hand it runs in the background: its log
#                                 is /opt/adrian/update.log
#   adrian auto-update on|off|status   check every hour and update by itself, only while
#                                 nobody is in her call and nothing is playing
#   adrian rollback               switch back to the previous version
#   adrian uninstall [--keep-data]
#   adrian version

set -euo pipefail
OPT=/opt/adrian
ETC=/etc/adrian
VAR=/var/lib/adrian
SERVICE=adrian-voice
NODE=$OPT/node/bin/node
APP=$OPT/current
# Where releases come from (adrian update, auto-update).
REPO=${ADRIAN_UPDATE_REPO:-Riqqqque/adrian-discord-voice}
UPDATE_UNITS=(adrian-update.service adrian-update.timer)
UNIT=/etc/systemd/system/$SERVICE.service
# The version the last update had to give up on. Root's, not in $VAR: the
# service must not be able to clear it, or plant one to stop an update.
FAILED=$OPT/update-failed
# Beside it when that version couldn't be judged: the old one wasn't healthy
# before the update either.
UNJUDGED=$OPT/update-failed.unjudged
# An update under way: "OLD NEW PHASE PREVIOUS" (PHASE: prep, switched, or
# rollback while it goes back; PREVIOUS: where "previous" pointed before it, or
# -), and the service file from before it (.unit). Left behind only when an
# update was cut off (power cut, killed), for the next update to finish.
MARK=$OPT/update-in-progress
# Where a by-hand update writes (it runs in the background).
UPDATE_LOG=$OPT/update.log
RUN_SYSTEMD=/run/systemd/system
# Free space an update needs under /opt: the bundle, the unpacked release and,
# now and then, a new Node.
UPDATE_NEEDS_MB=500

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run with sudo: sudo adrian $*"; }
tool_of() { # tool_of RELEASE_DIR ARGS: one release's node helper, as the service user, so files keep the right owner
  local dir=$1; shift
  runuser -u adrian -- env ADRIAN_CONFIG=$ETC/config.json ADRIAN_STATE=$VAR \
    LD_LIBRARY_PATH="$dir/node_modules/sherpa-onnx-linux-x64" "$NODE" "$dir/dist/cli/tool.js" "$@"
}
tool() { tool_of "$APP" "$@"; }
addr() { tool port; } # → "http 127.0.0.1 8790"
# url_host HOST [reach]: HOST as it goes in a URL (an IPv6 address in brackets).
# With reach, an address meaning "all of them" becomes loopback, as install.sh does.
url_host() {
  local h=$1
  if [ "${2:-}" = reach ]; then case $h in 0.0.0.0) h=127.0.0.1 ;; ::|'[::]') h=::1 ;; esac; fi
  case $h in \[*\]) ;; *:*) h="[$h]" ;; esac
  printf '%s\n' "$h"
}
health() { # health [timeout_s] → prints JSON, exit 0 if healthy
  local proto host port t=${1:-5}
  read -r proto host port < <(addr)
  host=$(url_host "$host" reach)
  curl -fsS -k --max-time "$t" "$proto://$host:$port/api/health"
}
health_body() { # health_body [timeout_s] → the answer whatever its status (a failed start is a 503)
  local proto host port t=${1:-5}
  read -r proto host port < <(addr)
  host=$(url_host "$host" reach)
  curl -sS -k --max-time "$t" "$proto://$host:$port/api/health"
}
# wait_healthy seconds [HEALTH]: healthy, and no worse than HEALTH (an earlier
# reply): running if it was running, in her call if it was in her call.
# A start the bot puts off until memory frees up is not a failure: the wait
# goes on while it says so, up to 17 min more (it loads anyway after 15), and
# the models then get the usual time to load.
wait_healthy() {
  local end=$((SECONDS + $1)) cap=$((SECONDS + 1020 + $1)) was=${2:-} out said=
  while [ $SECONDS -lt $end ]; do
    if out=$(health 3 2>/dev/null) && grep -q '"ok":true' <<<"$out" \
      && { ! grep -q '"state":"running"' <<<"$was" || grep -q '"state":"running"' <<<"$out"; } \
      && { ! grep -q '"voiceReady":true' <<<"$was" || grep -q '"voiceReady":true' <<<"$out"; }; then
      echo "$out"; return 0
    fi
    if [[ $out == *'"waitingFor":"memory"'* ]]; then # no grep: this runs every second
      [ -n "$said" ] || echo "waiting for free memory before the speech models load (up to 17 min)" >&2
      said=1
      end=$((SECONDS + $1 < cap ? SECONDS + $1 : cap))
    fi
    sleep 1
  done
  return 1
}
# /etc/adrian and /var/lib/adrian belong to the service account, which could
# plant a symbolic link there; root must never follow one (it could hand over
# or change system files).
refuse_symlinks() {
  local p
  for p in "$@"; do
    if [ -L "$p" ]; then die "$p is a symbolic link; refusing to continue (it must be a real file or directory)"; fi
  done
  return 0
}
current_version() { basename "$(readlink -f "$APP")"; }
# port_taken: when her admin page couldn't open its port (EADDRINUSE in the log
# since she last started), what to do about it. Says nothing otherwise.
port_taken() {
  local proto host port log since
  since=$(systemctl show -p ActiveEnterTimestamp --value "$SERVICE" 2>/dev/null || true)
  log=$(journalctl -u "$SERVICE" --no-pager -o cat -n 200 ${since:+--since "$since"} 2>/dev/null || true)
  grep -q 'EADDRINUSE' <<<"$log" || return 0
  read -r proto host port < <(addr) || true
  echo "port ${port:-?} is taken by another program, so her admin page can't start (EADDRINUSE in her log)."
  echo "See what holds it: sudo ss -ltnp 'sport = :${port:-PORT}'. Stop that program, or move her: run the installer again with --port N (a free one, for example $(( ${port:-8790} + 2 ))), then sudo adrian restart."
}
port_in_use() { # port_in_use PORT: something listens there right now (unknown without ss: no)
  command -v ss >/dev/null || return 1
  [ -n "$(ss -Hltn "sport = :$1" 2>/dev/null)" ]
}
latest_release() { # the newest published version, e.g. 0.14.9
  local json url tag
  # The API answers 60 times an hour per address; the release page's redirect
  # has no such limit, so a busy network (or a rate limit) still gets an answer.
  if json=$(curl -fsSL --max-time 20 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null); then
    "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const t=String(JSON.parse(s).tag_name||"").replace(/^v/,"");if(!/^[0-9][0-9A-Za-z.+-]*$/.test(t)||t.includes(".."))process.exit(1);console.log(t)})' <<<"$json" && return 0
  fi
  url=$(curl -fsSL --max-time 20 -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest" 2>/dev/null) || return 1
  tag=${url##*/tag/v}
  [ "$tag" != "$url" ] && [[ $tag =~ ^[0-9][0-9A-Za-z.+-]*$ && $tag != *..* ]] || return 1
  echo "$tag"
}
free_mb() { df -Pk "$1" 2>/dev/null | awk 'NR==2{print int($4/1024)}'; }
reachable() { # any HTTP answer counts: this is about the connection
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 12 -I "$1" 2>/dev/null) || true
  [ -n "$code" ] && [ "$code" != 000 ]
}
valid_version() { [[ $1 =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ && $1 != *..* ]]; }
put_mark() { # put_mark OLD NEW PHASE PREVIOUS: whole or not at all, even if cut off while writing
  refuse_symlinks "$MARK" "$MARK.new"
  printf '%s\n' "$*" >"$MARK.new" && mv -f "$MARK.new" "$MARK"
}
unit_back() { # the service file from before the update (saved in $MARK.unit), if it changed
  if [ -s "$MARK.unit" ] && ! cmp -s "$MARK.unit" "$UNIT"; then
    install -m 0644 "$MARK.unit" "$UNIT"
    systemctl daemon-reload
  fi
}
# roll_back OLD NEW PREVIOUS: give NEW up and go back to OLD under its own
# service file. The mark says so before the first step, and every step can be
# done twice, so one cut off halfway is finished by the next update or rollback.
roll_back() {
  local old=$1 new=$2 prev=${3:--}
  put_mark "$old" "$new" rollback "$prev"
  echo "$new" >"$FAILED"
  rm -f "$UNJUDGED"
  [ "$(current_version)" = "$old" ] || switch_to "$old"
  unit_back
  # "previous" goes back to what it was before the update: never the failed one.
  if [ "$prev" != - ] && [ "$prev" != "releases/$new" ] && [ -d "$OPT/$prev" ]; then
    ln -sfn "$prev" "$OPT/previous"
  else
    rm -f "$OPT/previous"
  fi
  systemctl restart "$SERVICE"
  rm -rf "${OPT:?}/releases/$new"
  rm -f "$MARK" "$MARK.unit"
}
answers_as() { grep -qF "\"version\":\"$1\"" <<<"$2"; } # answers_as VERSION HEALTH
# An update that was cut off: judge it now, so a half-done one never stays.
finish_interrupted() {
  [ -f "$MARK" ] || return 0
  refuse_symlinks "$MARK" "$MARK.unit"
  local old="" new="" phase="" prev="" cur out crashes
  read -r old new phase prev <"$MARK" || true
  if ! valid_version "$old" || ! valid_version "$new"; then
    echo "An update was cut off while it started; there was nothing of it to undo." >&2
    rm -f "$MARK" "$MARK.unit"; return 0
  fi
  [[ ${prev:--} =~ ^releases/[0-9A-Za-z][0-9A-Za-z.+-]*$ && $prev != *..* ]] || prev=-
  cur=$(current_version)
  set +e
  if [ "$phase" = rollback ] || { [ "$phase" = switched ] && [ "$cur" = "$old" ] && [ "$(previous_version)" = "$new" ]; }; then
    # Cut off while it went back. (Back on the old one with the new one as
    # "previous" is a rollback under way too, from a note that didn't say so.)
    # Finish it, failure and all.
    echo "The update to $new failed and was being undone when it was cut off. Finishing that: back to $old." >&2
    FINISHED="undone $old $new"
    roll_back "$old" "$new" "$prev"
    if wait_healthy 60 >/dev/null; then echo "Back on $old."; else echo "Back on $old, but it isn't healthy either: sudo adrian logs" >&2; fi
  elif [ "$cur" = "$new" ] && [ "$phase" != prep ] && [ -d "$OPT/releases/$old" ]; then
    # Only the new version's own answer counts: cut off between the switch and
    # the restart, the old process is still the one answering.
    out=$(wait_healthy 90 2>/dev/null) || out=""
    if ! answers_as "$new" "$out"; then
      echo "The update to $new was cut off before its checks finished. Starting $new to check it."
      systemctl restart "$SERVICE"
      crashes=$(systemctl show -p NRestarts --value "$SERVICE" 2>/dev/null)
      out=$(wait_healthy 120 2>/dev/null) || out=""
      [ "$(systemctl show -p NRestarts --value "$SERVICE" 2>/dev/null)" = "$crashes" ] || out=""
    fi
    if answers_as "$new" "$out"; then
      echo "The update to $new was cut off before its checks finished. $new is running and healthy, so it stays."
      FINISHED="kept $old $new"
    else
      echo "The update from $old to $new was cut off, and $new isn't healthy. Going back to $old." >&2
      FINISHED="undone $old $new"
      roll_back "$old" "$new" "$prev"
      if wait_healthy 60 >/dev/null; then echo "Back on $old."; else echo "Back on $old, but it isn't healthy either: sudo adrian logs" >&2; fi
    fi
  elif [ "$cur" = "$old" ]; then
    # Cut off before the switch took: what it had changed goes back.
    unit_back
    if [ "$prev" != - ] && [ "$prev" != "releases/$new" ] && [ -d "$OPT/$prev" ]; then ln -sfn "$prev" "$OPT/previous"; fi
    [ "$(previous_version)" = "$new" ] || rm -rf "${OPT:?}/releases/$new"
    echo "An update to $new was cut off before it switched over. What it changed is undone; $old is still the one running."
    FINISHED="undone $old $new"
  else
    # Something else (the installer, or a rollback by hand) has put $cur in place since.
    [ "$cur" = "$new" ] || [ "$(previous_version)" = "$new" ] || rm -rf "${OPT:?}/releases/$new"
    echo "An update ($old -> $new) was cut off, and $cur has been installed since; it stays."
  fi
  rm -f "$MARK" "$MARK.unit"
  set -e
}
update_running() { # another adrian update holds the lock right now
  command -v flock >/dev/null && [ -f "$OPT/update.lock" ] && ! flock -n "$OPT/update.lock" true
}
follow_hint() { # how to follow the update that holds the lock
  if systemctl is-active --quiet adrian-update.service 2>/dev/null; then echo "sudo journalctl -u adrian-update -f"
  else echo "sudo tail -f $UPDATE_LOG"; fi
}
take_update_lock() { # take_update_lock WHAT: one update (or rollback) at a time
  command -v flock >/dev/null || return 0
  exec 9>"$OPT/update.lock"
  flock -n 9 && return 0
  [ "$1" = --auto ] && { echo "update check skipped: another update is running"; exit 0; }
  die "another update is already running (the hourly check, or another terminal). Wait for it to finish; follow it: $(follow_hint)"
}
start_log() { # a by-hand update in the background, now holding the lock: its log starts afresh
  refuse_symlinks "$UPDATE_LOG"
  : >"$UPDATE_LOG"
  chmod 0600 "$UPDATE_LOG"
  exec >>"$UPDATE_LOG" 2>&1
  echo "== Update started $(date '+%F %T')${ADRIAN_UPDATE_TOKEN:+ (run $ADRIAN_UPDATE_TOKEN)}"
}
follow_running() { # another update holds the lock: follow it, and touch nothing of it
  local w rc
  if systemctl is-active --quiet adrian-update.service 2>/dev/null; then
    die "the hourly update check is updating her right now. Follow it: sudo journalctl -u adrian-update -f"
  fi
  echo "Another update is already running. Following its log, $UPDATE_LOG; Ctrl+C stops watching, not the update."
  ( while update_running; do command sleep 1; done ) &
  w=$!
  trap 'kill "$w" 2>/dev/null; echo; echo "Stopped watching. The update carries on: sudo tail -f $UPDATE_LOG"; exit 130' INT
  tail -n +1 -f --pid="$w" "$UPDATE_LOG" 2>/dev/null || true
  wait "$w" 2>/dev/null || true
  rc=$(cat "$OPT/update.rc" 2>/dev/null) || rc=""
  [[ $rc =~ ^[0-9]+$ ]] || rc=0
  exit "$rc"
}
# By hand at a terminal, an update runs on its own and this terminal only
# follows its log. Where systemd can, as a service of its own: outside the login
# session, so neither a dropped SSH connection nor logind ending the session at
# logout (KillUserProcesses) can stop it halfway. Otherwise in a session of its
# own (setsid), which a hang-up or Ctrl+C can't reach. Returns only if neither
# is there, to run here as before.
detach_update() { # detach_update ARGS...
  local rcf=$OPT/update.rc self token unit pid="" how="" started=0 envs envf="" v rc
  local run='bash "$1" update "${@:3}" </dev/null; echo $? >"$2"' # the update's exit code, for this terminal
  refuse_symlinks "$UPDATE_LOG" "$rcf"
  update_running && follow_running
  self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  token="$$-$RANDOM$RANDOM"
  rm -f "$rcf"
  if [ -d "$RUN_SYSTEMD" ] && command -v systemd-run >/dev/null; then
    unit=adrian-update-by-hand-$(date +%Y%m%d-%H%M%S)
    # A unit starts with systemd's environment, not this one.
    envs=(-E ADRIAN_DETACHED=1 -E "ADRIAN_UPDATE_TOKEN=$token" -E "PATH=$PATH")
    # The rest can hold a password (a proxy's user:password@): any user can read
    # a unit's Environment=, so they go in a file only root can read, which the
    # update deletes once it has started.
    envf=$OPT/.update-env-$token
    refuse_symlinks "$envf"
    (umask 077; : >"$envf")
    for v in ADRIAN_UPDATE_REPO ADRIAN_DOWNLOAD_CACHE ADRIAN_DOWNLOAD_MIRRORS https_proxy HTTPS_PROXY http_proxy HTTP_PROXY no_proxy NO_PROXY all_proxy ALL_PROXY; do
      [ -z "${!v:-}" ] || printf '%s="%s"\n' "$v" "$(sed 's/[\\"]/\\&/g' <<<"${!v}")" >>"$envf"
    done
    envs+=(-p "EnvironmentFile=$envf" -E "ADRIAN_ENV_FILE=$envf")
    if systemd-run --unit="$unit" --collect --quiet "${envs[@]}" "$(command -v bash)" -c 'rm -f "$ADRIAN_ENV_FILE"; unset ADRIAN_ENV_FILE; '"$run" adrian-update "$self" "$rcf" "$@" </dev/null >/dev/null 2>&1; then
      started=1
      pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null) || pid=""
      [[ $pid =~ ^[1-9][0-9]*$ ]] || pid="" # done already
      how="as its own service, $unit"
    fi
  fi
  [ -z "$envf" ] || [ "$started" = 1 ] || rm -f "$envf" # refused: nothing will read it
  if [ "$started" = 0 ]; then
    command -v setsid >/dev/null || return 0
    ADRIAN_DETACHED=1 ADRIAN_UPDATE_TOKEN=$token setsid bash -c "$run" adrian-update "$self" "$rcf" "$@" </dev/null >/dev/null 2>&1 &
    pid=$!
    how="in a session of its own"
  fi
  echo "Updating in the background ($how), so a dropped connection can't stop it halfway."
  echo "Following along here; Ctrl+C stops watching, not the update."
  echo "Its log: $UPDATE_LOG (follow it from anywhere: sudo tail -f $UPDATE_LOG)"
  trap 'echo; echo "Stopped watching. The update carries on: sudo tail -f $UPDATE_LOG, or sudo adrian status"; exit 130' INT
  # Until it holds the lock and has started its log afresh: never an earlier run's lines.
  for _ in $(seq 1 300); do
    [[ $(head -n 1 "$UPDATE_LOG" 2>/dev/null) == *"$token"* ]] && break
    [ ! -f "$rcf" ] || break
    [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null || break
    command sleep 0.1
  done
  if [[ $(head -n 1 "$UPDATE_LOG" 2>/dev/null) == *"$token"* ]]; then
    if [ -n "$pid" ]; then tail -n +1 -f --pid="$pid" "$UPDATE_LOG" 2>/dev/null || true; else cat "$UPDATE_LOG"; fi
  else
    echo "It didn't start: another update got there first. Follow that one: $(follow_hint)" >&2
  fi
  rc=$(cat "$rcf" 2>/dev/null) || rc=""
  [[ $rc =~ ^[0-9]+$ ]] || rc=1
  exit "$rc"
}
interrupted_note() { # for status and doctor: "running" while one is, "cut off" only when none is
  [ -f "$MARK" ] || return 0
  local what; what=$(awk '{print $1" -> "$2}' "$MARK" 2>/dev/null)
  if update_running; then echo "running: an update ($what) is under way right now"
  else echo "cut off: an update ($what) was cut off before it finished; sudo adrian update checks it and finishes or undoes it"; fi
}
newer() { # newer A B: true when version A is above B
  "$NODE" -e 'const[a,b]=process.argv.slice(1).map(v=>v.split(/[.+-]/).map(n=>parseInt(n,10)||0));for(let i=0;i<Math.max(a.length,b.length);i++){const d=(a[i]||0)-(b[i]||0);if(d)process.exit(d>0?0:1)}process.exit(1)' "$1" "$2"
}
fetch_release() { # fetch_release VERSION DIR: download the bundle and its checksum, verify, print the path
  local name="adrian-voice-$1-linux-x64.tar.gz" base="https://github.com/$REPO/releases/download/v$1"
  curl -fsSL --max-time 900 -o "$2/$name" "$base/$name" || return 1
  curl -fsSL --max-time 30 -o "$2/$name.sha256" "$base/$name.sha256" || return 1
  (cd "$2" && sha256sum -c --status "$name.sha256") || { echo "checksum mismatch for $name" >&2; return 1; }
  echo "$2/$name"
}
config_broken() { # why config.json can't be loaded, if it can't; unfinished setup (3) is fine
  local why rc=0
  why=$(tool check 2>&1 >/dev/null) || rc=$?
  [ "$rc" = 1 ] && echo "${why%%$'\n'*}"
}
config_refused() { # config_refused RELEASE_DIR: what that release has against the live config, if anything
  local out rc=0
  out=$(tool_of "$1" check 2>&1) || rc=$?
  # Only 3 is its answer. It runs before the release's Node is in, so a crash
  # says nothing about the config, and it mustn't block a release that moves Node.
  [ "$rc" = 3 ] && echo "$out"
}
# Auto-update leaves a version that failed here alone for a day, so a bad release
# can't restart her every hour, while a passing outage can't strand a good one.
failed_lately() { [ -f "$FAILED" ] && [ "$(cat "$FAILED")" = "$1" ] && [ -n "$(find "$FAILED" -mmin -1440)" ]; }
put_unit_back() { # the service file from before upgrade-prep.sh, if it changed
  if [ -s "$unit_before" ] && ! cmp -s "$unit_before" "$UNIT"; then
    install -m 0644 "$unit_before" "$UNIT"
    systemctl daemon-reload
  fi
}
previous_version() { # the release that was current before the last switch; nothing if none
  # Never fails: under set -e, prev=$(previous_version) would end the script with no word.
  [ ! -L "$OPT/previous" ] || basename "$(readlink -f "$OPT/previous")"
}
switch_to() { # remember where we came from, then swap the symlink atomically
  ln -sfn "releases/$(current_version)" "$OPT/previous"
  ln -sfn "releases/$1" "$OPT/current.new" && mv -Tf "$OPT/current.new" "$OPT/current"
}

cmd=${1:-status}; shift || true
case "$cmd" in
  status)
    need_root status
    systemctl --no-pager --lines=0 status "$SERVICE" 2>/dev/null | sed -n '1,4p' || true
    if h=$(health 3 2>/dev/null); then echo "health: $h"; else echo "health: not responding"; fi
    read -r proto host port < <(addr); echo "admin UI: $proto://$(url_host "$host"):$port/"
    n=$(interrupted_note); [ -z "$n" ] || echo "${n#*: }"
    ;;
  logs) journalctl -u "$SERVICE" --no-pager -n 200 -o cat "$@" ;;
  start|stop|restart) need_root "$cmd"; systemctl "$cmd" "$SERVICE"; [ "$cmd" = stop ] || wait_healthy 60 >/dev/null || die "not healthy after 60 s: adrian logs" ;;
  url) need_root url; read -r proto host port < <(addr); echo "$proto://$(url_host "$host"):$port/" ;;
  setup-code) need_root setup-code; tool setup-code "$@" ;;
  reset-admin) need_root reset-admin; tool reset-admin && systemctl restart "$SERVICE" ;;
  secret)
    need_root secret
    sub=${1:-}; name=${2:-}
    case "$sub" in
      set)
        [ -n "$name" ] || die "usage: adrian secret set NAME"
        if [ -t 0 ]; then read -r -s -p "Value for $name (hidden): " v; echo; else v=$(cat); fi
        printf '%s' "$v" | tool secret-set "$name"; unset v ;;
      delete) [ -n "$name" ] || die "usage: adrian secret delete NAME"; tool secret-delete "$name" ;;
      list) tool secret-list ;;
      *) die "usage: adrian secret set|delete|list [NAME]" ;;
    esac ;;
  satellite)
    need_root satellite
    sub=${1:-}; shift || true
    case "$sub" in
      add) [ $# -eq 2 ] || die "usage: adrian satellite add NAME OWNER_DISCORD_ID"; tool satellite-add "$1" "$2" ;;
      list) tool satellite-list ;;
      remove) [ $# -eq 1 ] || die "usage: adrian satellite remove ID"; tool satellite-remove "$1" ;;
      *) die "usage: adrian satellite add|list|remove" ;;
    esac ;;
  check) need_root check; tool check ;;
  config) need_root config; tool config "$@" ;;
  voice)
    need_root voice
    if [ $# -eq 0 ]; then tool voice; else tool voice "$@" && systemctl restart "$SERVICE" && wait_healthy 60 >/dev/null && echo "Restarted with the new voice."; fi ;;
  doctor)
    need_root doctor
    rc=0
    ok() { printf '  ok    %s\n' "$*"; }
    bad() { printf '  FAIL  %s\n' "$*"; rc=1; }
    warn() { printf '  warn  %s\n' "$*"; }
    echo "A.D.R.I.A.N. doctor (version $(current_version))"
    [ -x "$NODE" ] && ok "node $("$NODE" --version)" || bad "node runtime missing at $NODE"
    systemctl is-enabled --quiet "$SERVICE" && ok "service enabled" || bad "service not enabled"
    systemctl is-active --quiet "$SERVICE" && ok "service running" || bad "service not running"
    # A bot that failed to start still answers (503), so the page itself is up.
    h=$(health_body 3 2>/dev/null || true)
    if [ -z "$h" ]; then
      taken=$(port_taken)
      if [ -n "$taken" ]; then
        bad "admin UI not responding: ${taken%%$'\n'*}"
        printf '          what to do: %s\n' "${taken#*$'\n'}"
      else bad "admin UI not responding"; fi
    elif grep -q '"state":"failed"' <<<"$h"; then
      # Why, in words, from the last failed start in the log.
      why=$(journalctl -u "$SERVICE" --no-pager -o cat -n 2000 2>/dev/null | tool explain-log 2>/dev/null || true)
      if [ -n "$why" ]; then
        bad "the bot failed to start: ${why%%$'\n'*}"
        [ "${why#*$'\n'}" = "$why" ] || printf '          what to do: %s\n' "${why#*$'\n'}"
      else
        bad "the bot failed to start; the admin page's Status tab says why"
      fi
    else ok "health: $h"; fi
    if [ -f "$FAILED" ] && [ -f "$UNJUDGED" ]; then
      warn "update $(cat "$FAILED") was tried here on $(date -r "$FAILED" '+%F %H:%M') and undone, but it couldn't be judged: the bot wasn't healthy before it either. Fix what's above, then: sudo adrian update"
    elif [ -f "$FAILED" ]; then
      warn "update $(cat "$FAILED") failed here on $(date -r "$FAILED" '+%F %H:%M') and was undone; auto-update tries it again a day later, sudo adrian update any time"
    fi
    n=$(interrupted_note)
    case "$n" in running:*) warn "${n#*: }" ;; cut\ off:*) bad "${n#*: }" ;; esac
    [ "$(stat -c %a "$ETC/secrets.env")" = 600 ] && ok "secrets.env is 0600" || bad "secrets.env permissions are $(stat -c %a "$ETC/secrets.env") (want 600)"
    [ "$(stat -c %U "$ETC/secrets.env")" = adrian ] && ok "secrets.env owned by adrian" || bad "secrets.env owner is $(stat -c %U "$ETC/secrets.env")"
    # Files a command run as root by hand left behind: the service can't read or replace them.
    foreign=$(find "$ETC" "$VAR" -xdev \( -path "$VAR/models" -o -path "$VAR/install-manifest.json" \) -prune -o ! -user adrian -print 2>/dev/null | head -n 3 || true)
    if [ -z "$foreign" ]; then ok "her files belong to her (adrian)"
    else bad "files the service can't own: $(tr '\n' ' ' <<<"$foreign")(fix: sudo chown -R adrian:adrian $ETC $VAR && sudo chown -R root:adrian $VAR/models)"; fi
    if reachable https://discord.com/api/v10/gateway; then ok "discord.com reachable"
    else bad "can't reach discord.com: check this server's internet connection, DNS and firewall (outgoing HTTPS)"; fi
    reachable https://api.github.com/ && ok "github.com reachable (updates)" || warn "can't reach github.com: updates can't be downloaded until it can"
    for m in silero_vad.onnx sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8 kokoro-multi-lang-v1_0 sherpa-onnx-whisper-small vits-piper-vi_VN-vais1000-medium; do
      [ -e "$VAR/models/$m" ] && ok "model $m" || bad "model $m missing (re-run the installer)"
    done
    [ -x "$VAR/models/yt-dlp_linux" ] && ok "yt-dlp (music)" || warn "yt-dlp missing: music is off (re-run the installer or adrian update)"
    command -v ffmpeg >/dev/null && ok "ffmpeg (music)" || warn "ffmpeg not installed: music is off (Debian/Ubuntu: sudo apt install ffmpeg)"
    chk=$(mktemp)
    if tool check >"$chk" 2>&1; then ok "config complete"; else warn "setup not finished:"; sed 's/^/          /' "$chk"; fi
    rm -f "$chk"
    free_gb=$(df -Pk "$VAR" | awk 'NR==2{printf "%.1f", $4/1048576}')
    awk -v f="$free_gb" 'BEGIN{exit !(f>=2)}' && ok "disk: ${free_gb} GB free" || warn "disk: only ${free_gb} GB free"
    mem=$(systemctl show -p MemoryCurrent --value "$SERVICE" 2>/dev/null || echo)
    [[ $mem =~ ^[0-9]+$ ]] && ok "service memory: $((mem / 1048576)) MiB (limit 4096)"
    errs=$(journalctl -u "$SERVICE" --since "-15min" -p err --no-pager -o cat 2>/dev/null | tail -n 5)
    [ -z "$errs" ] && ok "no errors in the last 15 minutes" || { warn "recent errors:"; sed 's/^/          /' <<<"$errs"; }
    exit $rc ;;
  backup)
    need_root backup
    out=${1:-adrian-backup-$(date +%Y%m%d-%H%M%S).tar.gz}
    (umask 077; tar -czf "$out" -C / --exclude="${VAR#/}/models" "${ETC#/}" "${VAR#/}")
    echo "Backup written to $out (contains your keys: keep it private)" ;;
  restore)
    need_root restore
    f=${1:-}; [ -f "$f" ] || die "usage: adrian restore FILE"
    # Listed first, never piped: grep -q quits at its first match, tar dies of SIGPIPE,
    # and pipefail then skips the very die that match should have reached.
    names=$(tar -tzf "$f") || die "can't read $f; is it a complete backup?"
    long=$(tar -tvzf "$f") || die "can't read $f; is it a complete backup?"
    grep -qvE '^(etc/adrian|var/lib/adrian)(/|$)' <<<"$names" && die "backup contains paths outside etc/adrian and var/lib/adrian; refusing"
    grep -qE '(^|/)\.\.(/|$)' <<<"$names" && die "backup contains .. paths; refusing"
    grep -q '^[lh]' <<<"$long" && die "backup contains links; refusing"
    refuse_symlinks "$ETC" "$VAR" "$VAR/models"
    systemctl stop "$SERVICE"
    tar -xzf "$f" -C / --no-same-owner
    chown -R adrian:adrian "$ETC" "$VAR"; chown -R root:adrian "$VAR/models"
    refuse_symlinks "$ETC/secrets.env"
    chmod 0600 "$ETC/secrets.env"
    # The backup brings its own admin port: another program here may hold it.
    read -r _ _ port < <(addr) || port=
    if [[ ${port:-} =~ ^[0-9]+$ ]] && port_in_use "$port"; then
      die "restored, but not started: port $port, the admin port the backup brought, is already used by another program here. See what holds it: sudo ss -ltnp 'sport = :$port'. Stop that program, then sudo adrian start; or move her: run the installer again with --port N (a free port), then sudo adrian restart."
    fi
    systemctl start "$SERVICE"
    if wait_healthy 60 >/dev/null; then echo "Restored and running."; exit 0; fi
    taken=$(port_taken)
    [ -z "$taken" ] || die "restored, but she can't start: ${taken//$'\n'/ }"
    die "restored, but the service is not healthy: adrian logs" ;;
  update)
    need_root update
    b=latest require_sha=0
    for a in "$@"; do case "$a" in --require-checksum) require_sha=1 ;; *) b=$a ;; esac; done
    # A bundle by its full path: the update may run from another folder. The
    # words stay words, even next to a file of that name (wget saves one as "latest").
    case "$b" in
      latest|--auto|--check) ;;
      *) [ ! -f "$b" ] || b=$(cd "$(dirname "$b")" && pwd)/$(basename "$b") ;;
    esac
    # By hand at a terminal: the update runs in the background, so a dropped SSH
    # connection (or Ctrl+C) can't stop it halfway; this terminal follows along.
    if [ "$b" != --check ] && [ "$b" != --auto ] && [ -z "${ADRIAN_DETACHED:-}" ] && [ "${ADRIAN_DETACH:-}" != 0 ] \
      && { [ -t 1 ] || [ "${ADRIAN_DETACH:-}" = 1 ]; }; then
      if [ "$require_sha" = 1 ]; then detach_update "$b" --require-checksum; else detach_update "$b"; fi
    fi
    # One update at a time: the hourly check and one by hand must not cross.
    # --check only looks, so it takes no lock and leaves everything alone.
    if [ "$b" != --check ]; then
      take_update_lock "$b"
      # In the background: only now, holding the lock, does its log start afresh.
      [ "${ADRIAN_DETACHED:-}" != 1 ] || start_log
      rm -rf "$OPT"/.update-* "$OPT"/.prep-* # left by one that was cut off; nothing else uses them while the lock is held
      finish_interrupted
    fi
    case "$b" in
      --check)
        v=$(latest_release) || die "couldn't reach GitHub to see the newest release; check this server's internet connection"
        if newer "$v" "$(current_version)"; then echo "Version $v is available (installed: $(current_version)). Install it: sudo adrian update"
        else echo "Up to date ($(current_version))."; fi
        exit 0 ;;
      latest|--auto)
        auto=0; [ "$b" = --auto ] && auto=1
        v=$(latest_release) || { [ $auto = 1 ] && { echo "update check: couldn't reach GitHub"; exit 0; }; die "couldn't reach GitHub to see the newest release; check this server's internet connection, then run it again"; }
        if ! newer "$v" "$(current_version)"; then [ $auto = 1 ] || echo "Up to date ($(current_version))."; exit 0; fi
        # No version gets healthy on a config.json that won't load: don't download,
        # restart twice and roll back every hour until someone fixes it.
        if [ $auto = 1 ] && why=$(config_broken); then echo "update $v waits: $why"; exit 0; fi
        if [ $auto = 1 ] && failed_lately "$v"; then echo "update $v skipped: it failed here in the last day (try it by hand: sudo adrian update)"; exit 0; fi
        # Never restart her mid-call or mid-song: try again next hour.
        if [ $auto = 1 ] && h=$(health 5 2>/dev/null) && grep -q '"busy":true' <<<"$h"; then
          echo "update $v waits: someone is in her call or music is playing"; exit 0
        fi
        room=$(free_mb "$OPT")
        if [ -n "$room" ] && [ "$room" -lt "$UPDATE_NEEDS_MB" ]; then
          [ $auto = 1 ] && { echo "update $v waits: only $room MB free under $OPT, and it needs about $UPDATE_NEEDS_MB MB"; exit 0; }
          die "only $room MB free under $OPT, and the update needs about $UPDATE_NEEDS_MB MB. Free some space (for example: sudo apt-get clean) and run it again. Nothing was changed."
        fi
        # On the app's own disk: /tmp is often a small RAM disk.
        dl=$(mktemp -d "$OPT/.update-XXXXXX"); trap 'rm -rf "$dl"' EXIT
        echo "Downloading $v"
        b=$(fetch_release "$v" "$dl") || die "the download of $v failed or didn't match its checksum; nothing was changed. Check the internet connection and run it again."
        ;;
    esac
    [ -f "$b" ] || die "there's no bundle file $b. Usage: adrian update (the newest from GitHub), adrian update BUNDLE.tar.gz [--require-checksum], adrian update --check"
    if [ -f "$b.sha256" ]; then
      (cd "$(dirname "$b")" && sha256sum -c --status "$(basename "$b").sha256") || die "bundle checksum mismatch"
    elif [ "$require_sha" = 1 ]; then
      die "there's no $(basename "$b").sha256 next to $b, so it can't be checked (--require-checksum). Nothing was changed. Download the .sha256 from the same Releases page and put it next to the bundle."
    else
      echo "warning: NOT CHECKED: there's no $(basename "$b").sha256 next to $b, so a damaged or changed bundle would go unnoticed. Put the .sha256 from the same Releases page next to it (--require-checksum refuses to go on without one). sudo adrian update with no file downloads the newest and checks it." >&2
    fi
    if [ -z "${dl:-}" ]; then
      room=$(free_mb "$OPT")
      if [ -n "$room" ] && [ "$room" -lt "$UPDATE_NEEDS_MB" ]; then
        die "only $room MB free under $OPT, and the update needs about $UPDATE_NEEDS_MB MB. Free some space (for example: sudo apt-get clean) and run it again. Nothing was changed."
      fi
    fi
    tmp=$(mktemp -d "$OPT/.update-XXXXXX"); trap 'rm -rf "$tmp" ${dl:+"$dl"}' EXIT
    tar -xzf - -C "$tmp" --no-same-owner <"$b" || die "can't unpack $b (a damaged download, or a full disk); nothing was changed"
    new=$("$NODE" -p "require('$tmp/package.json').version")
    valid_version "$new" || die "bad version in bundle"
    old=$(current_version)
    prev_before=$(readlink "$OPT/previous" 2>/dev/null || true)
    [ "$new" != "$old" ] || die "version $new is already installed"
    rm -rf "$OPT/releases/$new"; mv "$tmp" "$OPT/releases/$new"; trap ${dl:+"rm -rf '$dl'"} EXIT
    chown -R root:root "$OPT/releases/$new"; chmod -R go-w "$OPT/releases/$new"; chmod 0755 "$OPT/releases/$new"
    # Room for what the new release still has to fetch (its models, a new Node),
    # from its own list: archives are staged under /opt, models unpack under /var/lib.
    # shellcheck source=/dev/null
    short=$( . "$OPT/releases/$new/packaging/downloads.sh" >/dev/null 2>&1 && declare -F disk_short >/dev/null && disk_short "$OPT" "$VAR/models" ) || short=""
    if [ -n "$short" ]; then
      rm -rf "${OPT:?}/releases/$new"
      [ "${auto:-0}" = 1 ] && { echo "update $new waits: ${short//$'\n'/; }"; exit 0; }
      die "not enough disk for $new: ${short//$'\n'/; }. Free some space (for example: sudo apt-get clean) and run it again. Nothing was changed."
    fi
    # Can the new code run this config? Asked as the service, before root runs
    # anything from the release, and only if she's running: unfinished setup is a 3 too.
    was=$(health 5 2>/dev/null || true)
    if grep -q '"state":"running"' <<<"$was" && why=$(config_refused "$OPT/releases/$new"); then
      rm -rf "${OPT:?}/releases/$new"; echo "$new" >"$FAILED"
      die "version $new can't run this config, so nothing was changed:"$'\n'"$why"
    fi
    unit_before=$MARK.unit; trap ${dl:+"rm -rf '$dl'"} EXIT
    refuse_symlinks "$MARK" "$unit_before"
    cp "$UNIT" "$unit_before" 2>/dev/null || : >"$unit_before"
    put_mark "$old" "$new" prep "${prev_before:--}"
    # The NEW release knows which models and service file it needs.
    if [ -f "$OPT/releases/$new/packaging/upgrade-prep.sh" ]; then
      bash "$OPT/releases/$new/packaging/upgrade-prep.sh" || { put_unit_back; rm -rf "${OPT:?}/releases/$new"; rm -f "$MARK" "$unit_before"; die "could not prepare $new (models, service file or Node); nothing was switched"; }
    fi
    # What the new version has to live up to. Fetching models can take a while,
    # so this is also the last look at whether someone has joined her call.
    # The answer whatever its status: a bot that failed to start answers 503.
    was=$(health_body 5 2>/dev/null || true)
    if [ "${auto:-0}" = 1 ] && grep -q '"busy":true' <<<"$was"; then
      put_unit_back; rm -rf "${OPT:?}/releases/$new"; rm -f "$MARK" "$unit_before"
      echo "update $new waits: someone is in her call or music is playing"; exit 0
    fi
    echo "Switching $old -> $new"
    put_mark "$old" "$new" switched "${prev_before:--}"
    switch_to "$new"
    echo "Watching $new for a minute or two"
    # A join alone can take 20 s after login, and a crash can come after a good
    # start: NRestarts counts the restarts systemd does by itself, from this one on.
    # The last check waits too: a voice drop can take most of a minute to come
    # back by itself, and one that lands here isn't the release's doing.
    if systemctl restart "$SERVICE" && crashes=$(systemctl show -p NRestarts --value "$SERVICE") \
      && wait_healthy 120 "$was" >/dev/null && sleep 60 && wait_healthy 60 "$was" >/dev/null \
      && [ "$(systemctl show -p NRestarts --value "$SERVICE")" = "$crashes" ]; then
      rm -f "$FAILED" "$UNJUDGED" "$MARK" "$unit_before"
      echo "Updated to $new."
      # keep the three newest releases
      ls -1t "$OPT/releases" | tail -n +4 | while read -r r; do [ "$r" != "$new" ] && [ "$r" != "$old" ] && rm -rf "${OPT:?}/releases/$r"; done
    else
      # From here every step is worth trying, whatever became of the one before.
      # wait_healthy at the end is what tells the person how it went.
      set +e
      unjudged=0
      if grep -q '"ok":true' <<<"$was"; then
        echo "Version $new did worse than $old; rolling back." >&2
      else
        # Nothing to compare with: say so, and still go back to how it was.
        unjudged=1
        how=$(sed -n 's/.*"state":"\([a-z]*\)".*/it was \1/p' <<<"$was")
        [ -n "$how" ] || how="it did not answer"
        echo "Version $new didn't come up healthy, but $old wasn't healthy before the update either ($how), so this doesn't show $new is worse. Going back to $old, to leave things as they were." >&2
      fi
      # Back under the service file $old ran under, "previous" back to what it
      # was before this update, and the failed release gone and remembered.
      roll_back "$old" "$new" "${prev_before:--}"
      [ "$unjudged" = 0 ] || : >"$UNJUDGED"
      wait_healthy 60 >/dev/null && die "rolled back to $old"
      [ "$unjudged" = 0 ] || die "rolled back to $old, but it is not healthy either, as before the update: sudo adrian doctor says why. Fix that first, then run sudo adrian update again."
      die "rolled back to $old, but it is not healthy either: adrian logs"
    fi ;;
  auto-update)
    need_root auto-update
    case ${1:-status} in
      on)
        for u in "${UPDATE_UNITS[@]}"; do install -m 0644 "$APP/packaging/$u" "/etc/systemd/system/$u"; done
        systemctl daemon-reload
        systemctl enable --now --quiet adrian-update.timer
        echo "Auto-update is on: every hour she checks GitHub and updates, only while nobody is in her call and nothing is playing."
        echo "See what it did: journalctl -u adrian-update" ;;
      off)
        systemctl disable --now --quiet adrian-update.timer 2>/dev/null || true
        for u in "${UPDATE_UNITS[@]}"; do rm -f "/etc/systemd/system/$u"; done
        systemctl daemon-reload
        echo "Auto-update is off. Update by hand with: sudo adrian update" ;;
      status)
        if systemctl is-enabled --quiet adrian-update.timer 2>/dev/null; then
          echo "Auto-update: on"
          systemctl list-timers adrian-update.timer --no-pager | sed -n '1,2p'
          journalctl -u adrian-update --no-pager -n 5 -o cat 2>/dev/null || true
        else
          echo "Auto-update: off (turn on: sudo adrian auto-update on)"
        fi ;;
      *) die "usage: adrian auto-update on|off|status" ;;
    esac ;;
  rollback)
    need_root rollback
    take_update_lock rollback
    FINISHED=""
    finish_interrupted
    # A cut-off update was just finished: that was the rollback asked for. Going
    # on would switch once more, to the release before it.
    read -r f_how f_old f_new <<<"$FINISHED" || true
    case "${f_how:-}" in
      undone) echo "The cut-off update to $f_new is undone, so she's on $(current_version) again. Nothing else was switched; run sudo adrian rollback again to go back further."; wait_healthy 5 >/dev/null; exit ;;
      kept) echo "The cut-off update to $f_new was finished and $f_new stays. Nothing else was switched; run sudo adrian rollback again to go back to $f_old."; wait_healthy 5 >/dev/null; exit ;;
    esac
    prev=$(previous_version); [ -n "$prev" ] || die "no previous version to roll back to"
    echo "Switching $(current_version) -> $prev"
    switch_to "$prev"; systemctl restart "$SERVICE"
    wait_healthy 60 >/dev/null && echo "Rolled back to $prev." || die "rolled back, but not healthy: adrian logs" ;;
  uninstall) need_root uninstall; exec bash "$APP/packaging/install.sh" --uninstall "$@" ;;
  version) current_version ;;
  -h|--help|help) sed -n '2,27p' "$0" ;;
  *) die "unknown command: $cmd (adrian help)" ;;
esac
