#!/usr/bin/env bash
# adrian: manage the A.D.R.I.A.N. Discord voice service.
#
#   adrian status                 service state, health, admin UI address
#   adrian logs [-f]              recent log (secrets are redacted)
#   adrian start|stop|restart
#   adrian url                    admin UI address
#   adrian setup-code [--new]     one-time code for creating the admin account
#   adrian reset-admin            forgot the password: remove the admin account
#   adrian secret set NAME        set a key (prompted, hidden); also: delete NAME, list
#   adrian check                  what's missing before the bot can start
#   adrian voice [NAME [SPEED]]   show or change the voice (restarts the bot)
#   adrian config KEY [VALUE]     show or change a setting, e.g. brain.extraBody.reasoning_effort medium
#   adrian satellite add NAME OWNER_ID   pair a PC (prints its token once); also: list, remove ID
#   adrian doctor                 full diagnostics
#   adrian backup [FILE]          config, keys and state (not models) to a tar.gz
#   adrian restore FILE
#   adrian update                 install the newest release from GitHub (checksum verified);
#                                 rolls back if it does worse than the old one. Also: update
#                                 BUNDLE.tar.gz, update --check (is there a newer one?)
#   adrian auto-update on|off|status   check every hour and update by itself, only while
#                                 nobody is in her call and nothing is playing
#   adrian rollback               switch back to the previous version
#   adrian uninstall [--keep-data]
#   adrian version

set -euo pipefail
OPT=/opt/adrian
ETC=/etc/adrian
VAR=/var/lib/adrian
SERVICE=adrian-voice
NODE=$OPT/node/bin/node
APP=$OPT/current
# Where releases come from (adrian update, auto-update).
REPO=${ADRIAN_UPDATE_REPO:-Riqqqque/adrian-discord-voice}
UPDATE_UNITS=(adrian-update.service adrian-update.timer)
UNIT=/etc/systemd/system/$SERVICE.service
# The version the last update had to give up on. Root's, not in $VAR: the
# service must not be able to clear it, or plant one to stop an update.
FAILED=$OPT/update-failed

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run with sudo: sudo adrian $*"; }
tool_of() { # tool_of RELEASE_DIR ARGS: one release's node helper, as the service user, so files keep the right owner
  local dir=$1; shift
  runuser -u adrian -- env ADRIAN_CONFIG=$ETC/config.json ADRIAN_STATE=$VAR \
    LD_LIBRARY_PATH="$dir/node_modules/sherpa-onnx-linux-x64" "$NODE" "$dir/dist/cli/tool.js" "$@"
}
tool() { tool_of "$APP" "$@"; }
addr() { tool port; } # → "http 127.0.0.1 8790"
health() { # health [timeout_s] → prints JSON, exit 0 if healthy
  local proto host port t=${1:-5}
  read -r proto host port < <(addr)
  [ "$host" = 0.0.0.0 ] && host=127.0.0.1
  curl -fsS -k --max-time "$t" "$proto://$host:$port/api/health"
}
# wait_healthy seconds [HEALTH]: healthy, and no worse than HEALTH (an earlier
# reply): running if it was running, in her call if it was in her call.
wait_healthy() {
  local end=$((SECONDS + $1)) was=${2:-} out
  while [ $SECONDS -lt $end ]; do
    if out=$(health 3 2>/dev/null) && grep -q '"ok":true' <<<"$out" \
      && { ! grep -q '"state":"running"' <<<"$was" || grep -q '"state":"running"' <<<"$out"; } \
      && { ! grep -q '"voiceReady":true' <<<"$was" || grep -q '"voiceReady":true' <<<"$out"; }; then
      echo "$out"; return 0
    fi
    sleep 1
  done
  return 1
}
# /etc/adrian and /var/lib/adrian belong to the service account, which could
# plant a symbolic link there; root must never follow one (it could hand over
# or change system files).
refuse_symlinks() {
  local p
  for p in "$@"; do
    if [ -L "$p" ]; then die "$p is a symbolic link; refusing to continue (it must be a real file or directory)"; fi
  done
  return 0
}
current_version() { basename "$(readlink -f "$APP")"; }
latest_release() { # the newest published version, e.g. 0.14.9
  local json
  json=$(curl -fsSL --max-time 20 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$REPO/releases/latest") || return 1
  "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const t=String(JSON.parse(s).tag_name||"").replace(/^v/,"");if(!/^[0-9][0-9A-Za-z.+-]*$/.test(t)||t.includes(".."))process.exit(1);console.log(t)})' <<<"$json"
}
newer() { # newer A B: true when version A is above B
  "$NODE" -e 'const[a,b]=process.argv.slice(1).map(v=>v.split(/[.+-]/).map(n=>parseInt(n,10)||0));for(let i=0;i<Math.max(a.length,b.length);i++){const d=(a[i]||0)-(b[i]||0);if(d)process.exit(d>0?0:1)}process.exit(1)' "$1" "$2"
}
fetch_release() { # fetch_release VERSION DIR: download the bundle and its checksum, verify, print the path
  local name="adrian-voice-$1-linux-x64.tar.gz" base="https://github.com/$REPO/releases/download/v$1"
  curl -fsSL --max-time 900 -o "$2/$name" "$base/$name" || return 1
  curl -fsSL --max-time 30 -o "$2/$name.sha256" "$base/$name.sha256" || return 1
  (cd "$2" && sha256sum -c --status "$name.sha256") || { echo "checksum mismatch for $name" >&2; return 1; }
  echo "$2/$name"
}
config_broken() { # why config.json can't be loaded, if it can't; unfinished setup (3) is fine
  local why rc=0
  why=$(tool check 2>&1 >/dev/null) || rc=$?
  [ "$rc" = 1 ] && echo "${why%%$'\n'*}"
}
config_refused() { # config_refused RELEASE_DIR: what that release has against the live config, if anything
  local out rc=0
  out=$(tool_of "$1" check 2>&1) || rc=$?
  # Only 3 is its answer. It runs before the release's Node is in, so a crash
  # says nothing about the config, and it mustn't block a release that moves Node.
  [ "$rc" = 3 ] && echo "$out"
}
# Auto-update leaves a version that failed here alone for a day, so a bad release
# can't restart her every hour, while a passing outage can't strand a good one.
failed_lately() { [ -f "$FAILED" ] && [ "$(cat "$FAILED")" = "$1" ] && [ -n "$(find "$FAILED" -mmin -1440)" ]; }
put_unit_back() { # the service file from before upgrade-prep.sh, if it changed
  if [ -s "$unit_before" ] && ! cmp -s "$unit_before" "$UNIT"; then
    install -m 0644 "$unit_before" "$UNIT"
    systemctl daemon-reload
  fi
}
previous_version() { # the release that was current before the last switch
  [ -L "$OPT/previous" ] && basename "$(readlink -f "$OPT/previous")"
}
switch_to() { # remember where we came from, then swap the symlink atomically
  ln -sfn "releases/$(current_version)" "$OPT/previous"
  ln -sfn "releases/$1" "$OPT/current.new" && mv -Tf "$OPT/current.new" "$OPT/current"
}

cmd=${1:-status}; shift || true
case "$cmd" in
  status)
    need_root status
    systemctl --no-pager --lines=0 status "$SERVICE" 2>/dev/null | sed -n '1,4p' || true
    if h=$(health 3 2>/dev/null); then echo "health: $h"; else echo "health: not responding"; fi
    read -r proto host port < <(addr); echo "admin UI: $proto://$host:$port/"
    ;;
  logs) journalctl -u "$SERVICE" --no-pager -n 200 -o cat "$@" ;;
  start|stop|restart) need_root "$cmd"; systemctl "$cmd" "$SERVICE"; [ "$cmd" = stop ] || wait_healthy 60 >/dev/null || die "not healthy after 60 s: adrian logs" ;;
  url) need_root url; read -r proto host port < <(addr); echo "$proto://$host:$port/" ;;
  setup-code) need_root setup-code; tool setup-code "$@" ;;
  reset-admin) need_root reset-admin; tool reset-admin && systemctl restart "$SERVICE" ;;
  secret)
    need_root secret
    sub=${1:-}; name=${2:-}
    case "$sub" in
      set)
        [ -n "$name" ] || die "usage: adrian secret set NAME"
        if [ -t 0 ]; then read -r -s -p "Value for $name (hidden): " v; echo; else v=$(cat); fi
        printf '%s' "$v" | tool secret-set "$name"; unset v ;;
      delete) [ -n "$name" ] || die "usage: adrian secret delete NAME"; tool secret-delete "$name" ;;
      list) tool secret-list ;;
      *) die "usage: adrian secret set|delete|list [NAME]" ;;
    esac ;;
  satellite)
    need_root satellite
    sub=${1:-}; shift || true
    case "$sub" in
      add) [ $# -eq 2 ] || die "usage: adrian satellite add NAME OWNER_DISCORD_ID"; tool satellite-add "$1" "$2" ;;
      list) tool satellite-list ;;
      remove) [ $# -eq 1 ] || die "usage: adrian satellite remove ID"; tool satellite-remove "$1" ;;
      *) die "usage: adrian satellite add|list|remove" ;;
    esac ;;
  check) need_root check; tool check ;;
  config) need_root config; tool config "$@" ;;
  voice)
    need_root voice
    if [ $# -eq 0 ]; then tool voice; else tool voice "$@" && systemctl restart "$SERVICE" && wait_healthy 60 >/dev/null && echo "Restarted with the new voice."; fi ;;
  doctor)
    need_root doctor
    rc=0
    ok() { printf '  ok    %s\n' "$*"; }
    bad() { printf '  FAIL  %s\n' "$*"; rc=1; }
    warn() { printf '  warn  %s\n' "$*"; }
    echo "A.D.R.I.A.N. doctor (version $(current_version))"
    [ -x "$NODE" ] && ok "node $("$NODE" --version)" || bad "node runtime missing at $NODE"
    systemctl is-enabled --quiet "$SERVICE" && ok "service enabled" || bad "service not enabled"
    systemctl is-active --quiet "$SERVICE" && ok "service running" || bad "service not running"
    if h=$(health 3 2>/dev/null); then ok "health: $h"; else bad "admin UI not responding"; fi
    [ ! -f "$FAILED" ] || warn "update $(cat "$FAILED") failed here on $(date -r "$FAILED" '+%F %H:%M') and was undone; auto-update tries it again a day later, sudo adrian update any time"
    [ "$(stat -c %a "$ETC/secrets.env")" = 600 ] && ok "secrets.env is 0600" || bad "secrets.env permissions are $(stat -c %a "$ETC/secrets.env") (want 600)"
    [ "$(stat -c %U "$ETC/secrets.env")" = adrian ] && ok "secrets.env owned by adrian" || bad "secrets.env owner is $(stat -c %U "$ETC/secrets.env")"
    for m in silero_vad.onnx sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8 kokoro-multi-lang-v1_0 sherpa-onnx-whisper-small vits-piper-vi_VN-vais1000-medium; do
      [ -e "$VAR/models/$m" ] && ok "model $m" || bad "model $m missing (re-run the installer)"
    done
    [ -x "$VAR/models/yt-dlp_linux" ] && ok "yt-dlp (music)" || warn "yt-dlp missing: music is off (re-run the installer or adrian update)"
    command -v ffmpeg >/dev/null && ok "ffmpeg (music)" || warn "ffmpeg not installed: music is off (Debian/Ubuntu: sudo apt install ffmpeg)"
    chk=$(mktemp)
    if tool check >"$chk" 2>&1; then ok "config complete"; else warn "setup not finished:"; sed 's/^/          /' "$chk"; fi
    rm -f "$chk"
    free_gb=$(df -Pk "$VAR" | awk 'NR==2{printf "%.1f", $4/1048576}')
    awk -v f="$free_gb" 'BEGIN{exit !(f>=2)}' && ok "disk: ${free_gb} GB free" || warn "disk: only ${free_gb} GB free"
    mem=$(systemctl show -p MemoryCurrent --value "$SERVICE" 2>/dev/null || echo)
    [[ $mem =~ ^[0-9]+$ ]] && ok "service memory: $((mem / 1048576)) MiB (limit 4096)"
    errs=$(journalctl -u "$SERVICE" --since "-15min" -p err --no-pager -o cat 2>/dev/null | tail -n 5)
    [ -z "$errs" ] && ok "no errors in the last 15 minutes" || { warn "recent errors:"; sed 's/^/          /' <<<"$errs"; }
    exit $rc ;;
  backup)
    need_root backup
    out=${1:-adrian-backup-$(date +%Y%m%d-%H%M%S).tar.gz}
    (umask 077; tar -czf "$out" -C / --exclude="${VAR#/}/models" "${ETC#/}" "${VAR#/}")
    echo "Backup written to $out (contains your keys: keep it private)" ;;
  restore)
    need_root restore
    f=${1:-}; [ -f "$f" ] || die "usage: adrian restore FILE"
    # Listed first, never piped: grep -q quits at its first match, tar dies of SIGPIPE,
    # and pipefail then skips the very die that match should have reached.
    names=$(tar -tzf "$f") || die "can't read $f; is it a complete backup?"
    long=$(tar -tvzf "$f") || die "can't read $f; is it a complete backup?"
    grep -qvE '^(etc/adrian|var/lib/adrian)(/|$)' <<<"$names" && die "backup contains paths outside etc/adrian and var/lib/adrian; refusing"
    grep -qE '(^|/)\.\.(/|$)' <<<"$names" && die "backup contains .. paths; refusing"
    grep -q '^[lh]' <<<"$long" && die "backup contains links; refusing"
    refuse_symlinks "$ETC" "$VAR" "$VAR/models"
    systemctl stop "$SERVICE"
    tar -xzf "$f" -C / --no-same-owner
    chown -R adrian:adrian "$ETC" "$VAR"; chown -R root:adrian "$VAR/models"
    refuse_symlinks "$ETC/secrets.env"
    chmod 0600 "$ETC/secrets.env"
    systemctl start "$SERVICE"
    wait_healthy 60 >/dev/null && echo "Restored and running." || die "restored, but the service is not healthy: adrian logs" ;;
  update)
    need_root update
    b=${1:-latest}
    case "$b" in
      --check)
        v=$(latest_release) || die "couldn't reach GitHub"
        if newer "$v" "$(current_version)"; then echo "Version $v is available (installed: $(current_version)). Install it: sudo adrian update"
        else echo "Up to date ($(current_version))."; fi
        exit 0 ;;
      latest|--auto)
        auto=0; [ "$b" = --auto ] && auto=1
        v=$(latest_release) || { [ $auto = 1 ] && { echo "update check: couldn't reach GitHub"; exit 0; }; die "couldn't reach GitHub"; }
        if ! newer "$v" "$(current_version)"; then [ $auto = 1 ] || echo "Up to date ($(current_version))."; exit 0; fi
        # No version gets healthy on a config.json that won't load: don't download,
        # restart twice and roll back every hour until someone fixes it.
        if [ $auto = 1 ] && why=$(config_broken); then echo "update $v waits: $why"; exit 0; fi
        if [ $auto = 1 ] && failed_lately "$v"; then echo "update $v skipped: it failed here in the last day (try it by hand: sudo adrian update)"; exit 0; fi
        # Never restart her mid-call or mid-song: try again next hour.
        if [ $auto = 1 ] && h=$(health 5 2>/dev/null) && grep -q '"busy":true' <<<"$h"; then
          echo "update $v waits: someone is in her call or music is playing"; exit 0
        fi
        dl=$(mktemp -d); trap 'rm -rf "$dl"' EXIT
        echo "Downloading $v"
        b=$(fetch_release "$v" "$dl") || die "download of $v failed"
        ;;
    esac
    [ -f "$b" ] || die "usage: adrian update [BUNDLE.tar.gz | --check]"
    if [ -f "$b.sha256" ]; then (cd "$(dirname "$b")" && sha256sum -c --status "$(basename "$b").sha256") || die "bundle checksum mismatch"; fi
    tmp=$(mktemp -d); trap 'rm -rf "$tmp" ${dl:+"$dl"}' EXIT
    tar -xzf "$b" -C "$tmp" --no-same-owner
    new=$("$NODE" -p "require('$tmp/package.json').version")
    [[ $new =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ && $new != *..* ]] || die "bad version in bundle"
    old=$(current_version)
    prev_before=$(readlink "$OPT/previous" 2>/dev/null || true)
    [ "$new" != "$old" ] || die "version $new is already installed"
    rm -rf "$OPT/releases/$new"; mv "$tmp" "$OPT/releases/$new"; trap ${dl:+"rm -rf '$dl'"} EXIT
    chown -R root:root "$OPT/releases/$new"; chmod -R go-w "$OPT/releases/$new"; chmod 0755 "$OPT/releases/$new"
    # Can the new code run this config? Asked as the service, before root runs
    # anything from the release, and only if she's running: unfinished setup is a 3 too.
    was=$(health 5 2>/dev/null || true)
    if grep -q '"state":"running"' <<<"$was" && why=$(config_refused "$OPT/releases/$new"); then
      rm -rf "${OPT:?}/releases/$new"; echo "$new" >"$FAILED"
      die "version $new can't run this config, so nothing was changed:"$'\n'"$why"
    fi
    unit_before=$(mktemp); trap 'rm -rf "$unit_before" ${dl:+"$dl"}' EXIT
    cp "$UNIT" "$unit_before" 2>/dev/null || : >"$unit_before"
    # The NEW release knows which models and service file it needs.
    if [ -f "$OPT/releases/$new/packaging/upgrade-prep.sh" ]; then
      bash "$OPT/releases/$new/packaging/upgrade-prep.sh" || { put_unit_back; rm -rf "${OPT:?}/releases/$new"; die "could not prepare $new (models, service file or Node); nothing was switched"; }
    fi
    # What the new version has to live up to. Fetching models can take a while,
    # so this is also the last look at whether someone has joined her call.
    was=$(health 5 2>/dev/null || true)
    if [ "${auto:-0}" = 1 ] && grep -q '"busy":true' <<<"$was"; then
      put_unit_back; rm -rf "${OPT:?}/releases/$new"
      echo "update $new waits: someone is in her call or music is playing"; exit 0
    fi
    echo "Switching $old -> $new"
    switch_to "$new"
    echo "Watching $new for a minute or two"
    # A join alone can take 20 s after login, and a crash can come after a good
    # start: NRestarts counts the restarts systemd does by itself, from this one on.
    # The last check waits too: a voice drop can take most of a minute to come
    # back by itself, and one that lands here isn't the release's doing.
    if systemctl restart "$SERVICE" && crashes=$(systemctl show -p NRestarts --value "$SERVICE") \
      && wait_healthy 120 "$was" >/dev/null && sleep 60 && wait_healthy 60 "$was" >/dev/null \
      && [ "$(systemctl show -p NRestarts --value "$SERVICE")" = "$crashes" ]; then
      rm -f "$FAILED"
      echo "Updated to $new."
      # keep the three newest releases
      ls -1t "$OPT/releases" | tail -n +4 | while read -r r; do [ "$r" != "$new" ] && [ "$r" != "$old" ] && rm -rf "${OPT:?}/releases/$r"; done
    else
      # From here every step is worth trying, whatever became of the one before.
      # wait_healthy at the end is what tells the person how it went.
      set +e
      echo "Version $new did worse than $old; rolling back." >&2
      switch_to "$old"
      # Its service file came in with it: back to the one $old ran under.
      put_unit_back
      systemctl restart "$SERVICE"
      echo "$new" >"$FAILED"
      # Forget the failed release: "previous" goes back to what it was before this update.
      if [ -n "$prev_before" ]; then ln -sfn "$prev_before" "$OPT/previous"; else rm -f "$OPT/previous"; fi
      rm -rf "${OPT:?}/releases/$new"
      wait_healthy 60 >/dev/null && die "rolled back to $old" || die "rolled back to $old, but it is not healthy either: adrian logs"
    fi ;;
  auto-update)
    need_root auto-update
    case ${1:-status} in
      on)
        for u in "${UPDATE_UNITS[@]}"; do install -m 0644 "$APP/packaging/$u" "/etc/systemd/system/$u"; done
        systemctl daemon-reload
        systemctl enable --now --quiet adrian-update.timer
        echo "Auto-update is on: every hour she checks GitHub and updates, only while nobody is in her call and nothing is playing."
        echo "See what it did: journalctl -u adrian-update" ;;
      off)
        systemctl disable --now --quiet adrian-update.timer 2>/dev/null || true
        for u in "${UPDATE_UNITS[@]}"; do rm -f "/etc/systemd/system/$u"; done
        systemctl daemon-reload
        echo "Auto-update is off. Update by hand with: sudo adrian update" ;;
      status)
        if systemctl is-enabled --quiet adrian-update.timer 2>/dev/null; then
          echo "Auto-update: on"
          systemctl list-timers adrian-update.timer --no-pager | sed -n '1,2p'
          journalctl -u adrian-update --no-pager -n 5 -o cat 2>/dev/null || true
        else
          echo "Auto-update: off (turn on: sudo adrian auto-update on)"
        fi ;;
      *) die "usage: adrian auto-update on|off|status" ;;
    esac ;;
  rollback)
    need_root rollback
    prev=$(previous_version); [ -n "$prev" ] || die "no previous version to roll back to"
    echo "Switching $(current_version) -> $prev"
    switch_to "$prev"; systemctl restart "$SERVICE"
    wait_healthy 60 >/dev/null && echo "Rolled back to $prev." || die "rolled back, but not healthy: adrian logs" ;;
  uninstall) need_root uninstall; exec bash "$APP/packaging/install.sh" --uninstall "$@" ;;
  version) current_version ;;
  -h|--help|help) sed -n '2,25p' "$0" ;;
  *) die "unknown command: $cmd (adrian help)" ;;
esac
