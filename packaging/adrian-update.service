[Unit]
Description=A.D.R.I.A.N. update check (installs a newer release when she isn't busy)
After=network-online.target adrian-voice.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/adrian update --auto
# A backstop: downloads.sh already gives up on a stalled connection within minutes.
# This one has to outlast a whole set of new models coming down a slow line.
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
